# Public URL of the site, without a trailing slash.
APP_URL="https://lapresa.example.com"

# Required. Generate a long random value (at least 32 characters). It protects
# every operation that can start/stop a stream or access/delete recordings.
ADMIN_API_KEY="replace-with-a-long-random-secret"

# ─── Self-hosted streaming configuration ───────────────────────────────────
# Port for the streaming control server
STREAM_SERVER_PORT=3001

# ─── Video Source Configuration ─────────────────────────────────────────────
# Options:
#   rtmp  → el celular publica en MediaMTX (ESTE es el modo de producción)
#   dshow → webcam en Windows
#   rtsp  → cámara IP
#   file  → archivo de video local
#   test  → patrón de prueba
STREAM_SOURCE=test

# ─── Ingesta RTMP desde el celular (STREAM_SOURCE=rtmp) ─────────────────────
# URL interna desde la que ffmpeg lee la señal que el celular publicó en
# MediaMTX. La ruta debe coincidir con la de mediamtx.yml, y el usuario/clave
# con el usuario "interno" de authInternalUsers.
RTMP_INGEST_URL="rtmp://interno:CAMBIAR-ESTA-TAMBIEN@127.0.0.1:1935/live/gallera"

# Cada cuántos segundos se reintenta mientras el celular no publica.
RTMP_RETRY_SECONDS=5

# ─── Calidad de salida (HLS multicalidad) ───────────────────────────────────
# Se generan SIEMPRE tres escalones en paralelo y el reproductor elige solo
# según la conexión de cada espectador. Estas variables definen el más alto:
# 720p es lo acordado (a 1080p el ancho de banda casi se duplica y en celular
# no se nota). Si la fuente manda menos, no se agranda.
VIDEO_MAX_HEIGHT=720
VIDEO_BITRATE=2500k
VIDEO_BUFSIZE=5000k

# Los dos escalones de abajo, fijos en 480p y 360p.
VIDEO_BITRATE_480=1200k
VIDEO_BITRATE_360=700k

# NOTA: la web consume /live/master.m3u8 (antes /live/live.m3u8). La URL la
# entrega el propio API en el campo hlsUrl, no hay que tocarla en el frontend.

# For rtsp: the RTSP URL of your camera (e.g., rtsp://192.168.1.100:554/stream)
# For file: the path to a local video file (e.g., ./test-video.mp4)
STREAM_SOURCE_URL=

# For dshow (Windows webcam): device names
# Run GET /api/devices to list available devices
DSHOW_VIDEO_DEVICE=
DSHOW_AUDIO_DEVICE=

# Directory where the HLS playlist and short video segments are generated.
# NGINX/CDN will expose this as https://your-domain/live/live.m3u8.
HLS_DIR=./hls
HLS_SEGMENT_SECONDS=4
HLS_LIST_SIZE=10

# ─── Recordings Configuration ──────────────────────────────────────────────
# Directory where recordings are saved
RECORDINGS_DIR=./recordings

# NOTA: hoy esta variable NO se lee. La retención está fija en 15 días dentro de
# server.ts (requerimiento del cliente). Editarla aquí no cambia nada.
# RECORDINGS_MAX_AGE_DAYS=15
