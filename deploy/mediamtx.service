[Unit]
Description=MediaMTX — ingesta RTMP desde el celular de la gallera
Documentation=https://github.com/bluenviron/mediamtx
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lapresa
Group=lapresa
# El puerto 1935 esta por encima de 1024, asi que no hacen falta privilegios.
ExecStart=/usr/local/bin/mediamtx /etc/lapresa/mediamtx.yml

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mediamtx

# ── Endurecimiento ──────────────────────────────────────────────────────────
# MediaMTX solo recibe la senal y la mantiene en memoria: no escribe nada.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
