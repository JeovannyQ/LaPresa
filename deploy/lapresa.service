[Unit]
Description=La Presa — API de transmision, clips y grabaciones
Documentation=https://github.com/JeovannyQ/LaPresa
After=network-online.target mediamtx.service
Wants=network-online.target
# No es Requires: si MediaMTX se cae, la API debe seguir viva para que el panel
# responda y el operador vea el error, en vez de quedarse sin sitio web.
After=var-lib-lapresa-live.mount
# Si revienta en bucle cerrado, systemd se rinde tras 5 intentos en 60 s para no
# dejar el servidor girando en vacio; se levanta a mano tras arreglar la causa.
# (Van en [Unit]: en [Service] systemd las ignora desde la v229.)
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=lapresa
Group=lapresa
WorkingDirectory=/opt/lapresa

# Las variables viven fuera del repo: /opt/lapresa se actualiza con git pull y
# un .env ahi dentro se perderia (o peor, se commitearia) en cada despliegue.
EnvironmentFile=/etc/lapresa/lapresa.env

# server.js lo genera "npm run build:server" (esbuild). Se ejecuta node directo,
# sin tsx, para no depender de devDependencies en produccion.
ExecStart=/usr/bin/node /opt/lapresa/server.js

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lapresa

# ── Endurecimiento ──────────────────────────────────────────────────────────
# El proceso lanza ffmpeg y escribe video: se le da acceso solo a donde debe.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lapresa
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# ffmpeg puede comerse la maquina entera con 3 codificaciones en paralelo; este
# techo deja aire para nginx y para poder entrar por SSH a apagar el desastre.
MemoryMax=8G

[Install]
WantedBy=multi-user.target
