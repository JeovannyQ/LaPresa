* text=auto

# Estos archivos se ejecutan en el VPS. Con finales de linea CRLF, bash falla
# con "bad interpreter" en la primera linea del script y los units de systemd
# quedan sucios. Se fuerzan a LF pase cual pase la configuracion de git de
# quien clone el repositorio.
*.sh      text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.yml     text eol=lf
