* text=auto

# Estos archivos se ejecutan dentro de contenedores Linux. Con finales de linea
# CRLF, bash falla con "bad interpreter" y las continuaciones de linea del
# Dockerfile se rompen. Se fuerzan a LF pase cual pase la configuracion de git
# de quien clone el repositorio (que en Windows suele convertir a CRLF sola).
*.sh       text eol=lf
*.yml      text eol=lf
Dockerfile text eol=lf
